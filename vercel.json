{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "excludeFiles": "{venv/**,venv_latest/**,venv_new/**,FOR_UPLOAD/**,__pycache__/**,*.pyc,uploads/**,uvicorn.log}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
