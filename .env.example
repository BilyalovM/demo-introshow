# Intro Show CRM — пример переменных окружения
# Скопируйте: cp .env.example .env  и заполните значения.
# Не коммитьте .env с секретами.

# --- Обязательно для продакшена ---
# Postgres (обязательно для прода). Без переменной — SQLite (демо/локально).
# БЕЗ Postgres на Vercel данные могут пропадать (/tmp SQLite эфемерен).
DATABASE_URL=postgresql+psycopg2://introshow:CHANGE_ME@localhost:5432/introshow

# Опционально: явный путь SQLite на VPS-томе (не для Vercel)
# RENTAL_DB_PATH=/var/introshow/rental_app.db

# Секрет подписи cookie-сессий (длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string

# Опциональный алиас (приложение использует SESSION_SECRET)
# SECRET_KEY=

# Каталог загрузок (смета PDF, вложения). По умолчанию ./uploads
# RENTAL_UPLOADS_DIR=/var/introshow/uploads

# TTL сессии в часах (по умолчанию 168 = 7 дней)
# SESSION_MAX_AGE_HOURS=168

# --- Интеграции (опционально) ---
# GEMINI_API_KEY=
# TG_BOT_TOKEN=
# IG_PAGE_TOKEN=
# IG_VERIFY_TOKEN=
# ONEC_API_KEY=
# LEAD_API_KEY=

# WhatsApp Web bridge (self-hosted на VPS, см. docs/whatsapp-web.md)
# CRM → bridge (исходящие + статус/QR в Настройках)
# WA_BRIDGE_URL=https://wa.your-vps.example
# WA_WEB_API_KEY=change-me-long-random
# Локальная отладка без ключа (НЕ для прода): WA_WEB_ALLOW_OPEN=1
#
# Bridge → CRM (в docker-compose / wa_bridge env):
# CRM_URL=https://demo-introshow.vercel.app
# WA_WEB_API_KEY=тот-же-секрет
#
# Опционально: WAHA как fallback (если bridge не используется)
# WAHA_URL=http://127.0.0.1:3000

# Vercel выставляет VERCEL=1 автоматически (SQLite в /tmp)
